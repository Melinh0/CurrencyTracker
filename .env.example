# ============================================
# CurrencyTracker - Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha os valores

# --------------------------------------------
# App Config
# --------------------------------------------
APP_NAME=CurrencyTracker
DEBUG=false
LOG_LEVEL=INFO
SECRET_KEY=gere-uma-chave-secreta-forte-aqui
API_V1_PREFIX=/api/v1

# --------------------------------------------
# Database - PostgreSQL (dados relacionais)
# --------------------------------------------
DATABASE_URL=postgresql://currency_user:currency_pass@localhost:5432/currency_tracker
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --------------------------------------------
# Database - InfluxDB (time series)
# --------------------------------------------
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=meu-token-influxdb-super-secreto
INFLUXDB_ORG=currency-tracker
INFLUXDB_BUCKET=rates
INFLUXDB_BUCKET_PREDICTIONS=predictions

# --------------------------------------------
# Cache - Redis
# --------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=60

# --------------------------------------------
# APIs Externas - Coleta de Taxas
# --------------------------------------------
# AwesomeAPI (Brasil - gratuito)
AWESOME_API_URL=https://economia.awesomeapi.com.br
AWESOME_API_KEY=

# ExchangeRate-API (160+ moedas)
EXCHANGE_RATE_API_URL=https://v6.exchangerate-api.com/v6
EXCHANGE_RATE_API_KEY=

# Alpha Vantage (dados históricos + tempo real)
ALPHA_VANTAGE_API_URL=https://www.alphavantage.co/query
ALPHA_VANTAGE_API_KEY=

# Twelve Data (WebSocket tempo real)
TWELVE_DATA_API_URL=https://api.twelvedata.com
TWELVE_DATA_API_KEY=
TWELVE_DATA_WS_URL=wss://ws.twelvedata.com/v1/quotes/price

# Banco Central do Brasil (PTAX oficial)
BCB_API_URL=https://api.bcb.gov.br/dados/serie/bcdata.sgs

# Yahoo Finance (via yfinance)
YAHOO_FINANCE_ENABLED=true

# Investing.com (scraping para moedas exóticas)
INVESTING_COM_ENABLED=false

# --------------------------------------------
# Machine Learning
# --------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=currency-prediction
MODEL_REGISTRY_PATH=./models/registry
DEFAULT_PREDICTION_HORIZON_DAYS=7
RETRAIN_INTERVAL_HOURS=24
MIN_TRAINING_SAMPLES=100

# --------------------------------------------
# Alertas e Notificações
# --------------------------------------------
# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false

# Discord
DISCORD_WEBHOOK_URL=
DISCORD_ENABLED=false

# Email (SMTP)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=CurrencyTracker <noreply@currencytracker.local>
EMAIL_ENABLED=false

# Webhook genérico
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=

# --------------------------------------------
# Scheduler / Celery
# --------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TIMEZONE=America/Sao_Paulo
COLLECTION_INTERVAL_SECONDS=60
HEALTH_CHECK_INTERVAL_SECONDS=300

# --------------------------------------------
# Frontend / Dashboard
# --------------------------------------------
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
REACT_APP_API_URL=http://localhost:8000

# --------------------------------------------
# Moedas Monitoradas (códigos ISO 4217)
# --------------------------------------------
BASE_CURRENCY=BRL
TRACKED_CURRENCIES=USD,EUR,GBP,JPY,RUB,ARS,CLP,COP,MXN,CNY,INR,ZAR,AUD,CAD,CHF

# --------------------------------------------
# Feature Flags
# --------------------------------------------
ENABLE_WEBSOCKET_COLLECTOR=false
ENABLE_ML_PREDICTIONS=true
ENABLE_ALERTS=true
ENABLE_DASHBOARD=true
ENABLE_API_DOCS=true